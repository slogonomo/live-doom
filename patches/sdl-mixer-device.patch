+/* Live Doom callers serialize this with every other mixer operation on the
+ * main thread. Never invoke it from a callback or while Mix_LockAudio is held. */
+int Mix_LiveDoomSuspendDevice(int suspend)
+{
+    SDL_AudioSpec desired, obtained;
+    SDL_AudioDeviceID next;
+
+    if (!audio_opened) {
+        return SDL_SetError("Mixer is not initialized");
+    }
+    if (suspend) {
+        if (!live_doom_device_detached) {
+            /* Close joins the callback before releasing the physical stream.
+             * Keep every decoder, channel, effect, hook and preference intact. */
+            live_doom_close_device();
+            live_doom_device_detached = 1;
+        }
+        return 0;
+    }
+    if (!live_doom_device_detached) {
+        return 0;
+    }
+
+    /* A new device starts paused. Reuse the exact mixer format so retained
+     * decoder/resampler state and the engine postmix buffer remain valid. */
+    desired = mixer;
+    desired.callback = mix_channels;
+    desired.userdata = NULL;
+    next = SDL_OpenAudioDevice(NULL, 0, &desired, &obtained, 0);
+    if (!next) {
+        return -1;
+    }
+    if (obtained.freq != mixer.freq || obtained.format != mixer.format ||
+        obtained.channels != mixer.channels || obtained.samples != mixer.samples) {
+        SDL_CloseAudioDevice(next);
+        return SDL_SetError("Audio device format changed");
+    }
+    audio_device = next;
+    live_doom_device_detached = 0;
+    SDL_PauseAudioDevice(audio_device, live_doom_audio_paused);
+    return 0;
+}
+
+int Mix_LiveDoomDeviceSuspended(void)
+{
+    return live_doom_device_detached;
+}
