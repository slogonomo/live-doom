+/**
+ * Release or reopen the physical device without resetting the mixer.
+ *
+ * Live Doom extension: decoder/channel state, hooks, effects, volume and the
+ * logical open count are retained. Playback freezes while detached. Resume
+ * reopens the default output with the exact existing format and preserves the
+ * state last set by Mix_PauseAudio(). It does not start a song again.
+ *
+ * Call only on the main thread, serialized with all other mixer operations,
+ * outside audio callbacks and with no Mix_LockAudio() lock held.
+ *
+ * \param suspend nonzero to detach, zero to reopen; either is idempotent.
+ * \returns 0 on success, -1 if uninitialized or reopen fails. A failed reopen
+ *          leaves the device detached and playback stopped, ready for retry.
+ */
+extern DECLSPEC int SDLCALL Mix_LiveDoomSuspendDevice(int suspend);
+
+/**
+ * Return nonzero while the Live Doom physical device is detached.
+ *
+ * Uses the same main-thread serialization contract as the suspend operation.
+ * The mixer remains logically initialized until Mix_CloseAudio() is called.
+ */
+extern DECLSPEC int SDLCALL Mix_LiveDoomDeviceSuspended(void);
+
