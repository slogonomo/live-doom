+           players[consoleplayer].health <= 0 || !botMap)
+            return "ERR no live bot navigation\n";
+        bots[consoleplayer].mapInit();
+        progress.tics = 0;
+        ++replans;
+    } else if(sscanf(line.c_str(), "video %d %d %c", &width, &height, &tail) == 2) {
+        if(width < 320 || height < 200 || width > DD_MAX_WIDTH || height > DD_MAX_HEIGHT)
+            return "ERR video dimensions out of range\n";
+        // Native mode reset rebuilds projection, buffers and HUD geometry. It
+        // does not tick, replace the game world or touch the audio device.
+        if(video.width != width || video.height != height) {
+            char mode[48];
+            snprintf(mode, sizeof(mode), "%dx%dw", width, height);
+            efree(i_videomode);
+            i_videomode = estrdup(mode);
+            efree(i_default_videomode);
+            i_default_videomode = estrdup(mode);
+            I_SetMode();
+        }
+    } else if(line == "quit") {
+        stopping = 1;
+    } else if(line == "quit-nosave") {
+        checkpointOnStop = false;
+        stopping = 1;
+    } else return "ERR unknown or malformed command\n";
+    ++revision;
+    applyMode();
+    return "OK\n";
+}
+}
+
+bool DD_Active() { return enabled; }
+bool DD_Requested() { return desktopRequested; }
+bool DD_Paused() { return suspended; }
+bool DD_FrameDirty() { return enabled && revision != publishedRevision; }
+unsigned DD_RenderFPS() { return autoplay ? 35 : humanRenderFPS; }
+int DD_RenderLerp() { return autoplay || suspended ? FRACUNIT : renderLerp; }
+void DD_SetRenderLerp(int fraction) { renderLerp = std::max(0, std::min(fraction, FRACUNIT)); }
+
+bool DD_NativeQuit()
+{
+    if(!enabled) return false;
+    if(!nativeQuitPending) ++humanQuits;
+    nativeQuitPending = true;
+    return true;
+}
+
+static void DD_FinishNativeQuit()
+{
+    if(!nativeQuitPending) return;
+    nativeQuitPending = false;
+    // The native menu's Quit leaves desktop takeover, preserving this world.
+    // Service shutdown uses the bridge quit commands and still exits normally.
+    // Complete outside D_ProcessEvents: posting held-key releases inside a
+    // responder would re-enter its current event before the ring tail advances.
+    releaseInput();
+    MN_ClearMenus();
+    Console.current_height = Console.current_target = Console.prev_height = 0;
+    owner = agentGeneration = 0;
+    autoplay = true;
+    clearAgentAction();
+    audible = false;
+    if(botMap && players[consoleplayer].mo) bots[consoleplayer].mapInit();
+    ++revision;
+    applyMode();
+}
+
+void DD_Init()
+{
+    const char *framePath = getenv("DOOM_DESKTOP_FRAME");
+    const char *socketEnv = getenv("DOOM_DESKTOP_ENGINE_SOCKET");
+    if(!framePath && !socketEnv) return;
+    if(!framePath || !socketEnv || framePath[0] != '/' || socketEnv[0] != '/')
+        I_Error("Desktop bridge requires absolute frame and socket paths\n");
+    socketPath = socketEnv;
+    if(socketPath.size() >= sizeof(sockaddr_un::sun_path))
+        I_Error("Desktop engine socket path is too long\n");
+    int fd = open(framePath, O_RDWR | O_CREAT | O_NOFOLLOW | O_CLOEXEC, 0600);
+    struct stat info;
+    if(fd < 0 || fstat(fd, &info) != 0 || !S_ISREG(info.st_mode) || info.st_uid != geteuid() ||
+       fchmod(fd, 0600) != 0 || ftruncate(fd, DD_FILE_SIZE) != 0)
+        I_Error("Cannot create desktop framebuffer: %s\n", strerror(errno));
+    header = static_cast<DDHeader *>(mmap(nullptr, DD_FILE_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0));
+    close(fd);
+    if(header == MAP_FAILED) {
+        header = nullptr;
+        I_Error("Cannot map desktop framebuffer: %s\n", strerror(errno));
+    }
+    // Leave unused capacity sparse at small test resolutions. A fresh frame
+    // overwrites its pixel region before the nonzero frame counter is visible.
+    memset(header, 0, DD_HEADER_SIZE);
+    if(lstat(socketPath.c_str(), &info) == 0) {
+        if(!S_ISSOCK(info.st_mode) || info.st_uid != geteuid())
+            I_Error("Refusing to replace non-owned desktop socket\n");
+        unlink(socketPath.c_str());
+    }
+    listener = socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+    sockaddr_un address = {};
+    address.sun_family = AF_UNIX;
+    strcpy(address.sun_path, socketPath.c_str());
+    if(listener < 0 || bind(listener, reinterpret_cast<sockaddr *>(&address), sizeof(address)) != 0 ||
+       chmod(socketPath.c_str(), 0600) != 0 || listen(listener, 16) != 0)
+        I_Error("Cannot create desktop command socket: %s\n", strerror(errno));
+    header->magic = DD_MAGIC;
+    header->version = DD_VERSION;
+    header->pid = getpid();
+    enabled = true;
+    startupSkill = gameskill;
+    startupMap = gamestate == GS_LEVEL && usergame && !demoplayback ? gamemapname :
+                 (GameModeInfo->flags & GIF_MAPXY ? "MAP01" : "E1M1");
+    d_fastrefresh = d_interpolate = true;
+    if(video.width > DD_MAX_WIDTH || video.height > DD_MAX_HEIGHT)
+        I_Error("Desktop video mode exceeds %dx%d capacity\n", DD_MAX_WIDTH, DD_MAX_HEIGHT);
+    // Add familiar movement alongside the original arrows and mouse bindings.
+    C_RunTextCmd("bind w forward");
+    C_RunTextCmd("bind s backward");
+    C_RunTextCmd("bind a moveleft");
+    C_RunTextCmd("bind d moveright");
+    C_RunTextCmd("bind e use");
+    applyControls();
+    applyMode();
+    if(gameaction == ga_loadgame) {
+        G_ApplyPendingLoadGame();
+        applyControls();
+        if(botMap && players[consoleplayer].mo) bots[consoleplayer].mapInit();
+        applyMode();
+    }
+    signal(SIGTERM, stopSignal);
+    signal(SIGINT, stopSignal);
+    atexit(cleanup);
+    lastSave = SDL_GetTicks64();
+}
+
+void DD_Poll()
+{
+    if(!enabled) return;
+    // SDL events precede bridge commands, exactly as they did in the outer
+    // loop. Input commands then drain individually so keyups cannot be lost.
+    D_ProcessEvents();
+    const uint64_t now = SDL_GetTicks64();
+    for(int count = 0; count < 32; ++count) {
+        int fd = accept4(listener, nullptr, nullptr, SOCK_NONBLOCK | SOCK_CLOEXEC);
+        if(fd < 0) break;
+        if(clients.size() >= 64) close(fd);
+        else clients.push_back({fd, {}, {}, now});
+    }
+    for(size_t i = 0; i < clients.size();) {
+        auto &client = clients[i];
+        char chunk[512];
+        bool done = now - client.lastActivity >= 1000;
+        while(!done && !client.eof) {
+            const ssize_t length = recv(client.fd, chunk, sizeof(chunk), 0);
+            if(length > 0) {
+                client.received += length;
+                client.lastActivity = now;
+                if(client.received > 4096) {
+                    client.output += "ERR command batch too large\n";
+                    client.eof = true;
+                    client.input.clear();
+                    break;
+                }
+                client.input.append(chunk, length);
+            } else if(length == 0) {
+                client.eof = true;
+                break;
+            } else if(errno == EINTR) continue;
+            else {
+                if(errno != EAGAIN && errno != EWOULDBLOCK) done = true;
+                break;
+            }
+        }
+        size_t newline;
+        while(!done && (newline = client.input.find('\n')) != std::string::npos) {
+            std::string line = client.input.substr(0, newline);
+            client.input.erase(0, newline + 1);
+            if(!line.empty() && line.back() == '\r') line.pop_back();
+            if(++client.commands > 128) {
+                client.output += "ERR too many commands\n";
+                client.eof = true;
+                client.input.clear();
+                break;
+            }
+            client.output += command(line);
+            if(stopping) {
+                client.eof = true;
+                client.input.clear();
+                break;
+            }
+        }
+        if(client.eof && !client.input.empty()) {
+            client.output += "ERR incomplete command\n";
+            client.input.clear();
+        }
+        if(!done && !client.output.empty()) {
+            const ssize_t length = send(client.fd, client.output.data(), client.output.size(), MSG_NOSIGNAL);
+            if(length > 0) client.output.erase(0, length);
+            else if(length == 0 || (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) done = true;
+        }
+        if(client.eof && client.output.empty()) done = true;
+        if(done) {
+            close(client.fd);
+            clients.erase(clients.begin() + i);
+        } else ++i;
+    }
+    DD_FinishNativeQuit();
+    recoverAmbientWorld();
+    applyMode();
+    if(!stopping && now - lastSave >= 30000) {
+        save();
+        lastSave = now;
+    }
+    if(stopping) {
+        if(checkpointOnStop) save();
+        I_QuitFast();
+    }
+}
+
+void DD_RunTic()
+{
+    recoverAmbientWorld();
+    const int previousState = gamestate;
+    observeLifecycle();
+    MN_Ticker();
+    C_Ticker();
+    V_FPSTicker();
+    G_BuildTiccmd(&netcmds[consoleplayer][gametic % BACKUPTICS], players[consoleplayer], g_input, true);
+    if(advancedemo) D_DoAdvanceDemo();
+    i_haltimer.SaveMS();
+    G_Ticker();
+    recoverAmbientWorld();
+    applyMode();
+    if(previousState != gamestate) {
+        agentLifecycleState = gamestate;
+        agentLifecycleTics = 0;
+        clearAgentAction();
+    }
+    observeLifecycle();
+    watchBotProgress();
+    ++gametic;
+    maketic = gametic;
+}
+
+bool DD_ApplyAgentCommand(int index, ticcmd_t *cmd)
+{
+    if(!enabled || owner != 1 || index != consoleplayer || demoplayback) return false;
+    // Preserve consistency while replacing every gameplay/input field. An
+    // expired or absent action is neutral, never a return to AutoDoom walking.
+    const int16_t consistency = cmd->consistency;
+    std::memset(cmd, 0, sizeof(*cmd));
+    cmd->consistency = consistency;
+    if(suspended || paused) return true;
+    if(agentLifecycleState != gamestate) {
+        agentLifecycleState = gamestate;
+        agentLifecycleTics = 0;
+        clearAgentAction();
+    }
+    player_t &player = players[index];
+    if(gamestate != GS_LEVEL) {
+        clearAgentAction();
+        if(gamestate == GS_INTERMISSION && GameModeInfo->interfuncs->TallyDone()) {
+            if(++agentLifecycleTics > 100 && gametic % 2) cmd->buttons = BT_USE;
+        } else if(gamestate == GS_FINALE) {
+            if(++agentLifecycleTics > 5 * 35 && gametic % 35 == 0) cmd->buttons = BT_USE;
+        }
+        return true;
+    }
+    if(player.health <= 0) {
+        clearAgentAction();
+        if(gametic % 128 == 0) cmd->buttons = BT_USE;
+        return true;
+    }
+    if(!agentAction.remaining) return true;
+    const auto action = agentAction;
+    --agentAction.remaining;
+    cmd->forwardmove = static_cast<int8_t>(std::lround(action.move * player.pclass->forwardmove[action.run]));
+    cmd->sidemove = static_cast<int8_t>(std::lround(action.strafe * player.pclass->sidemove[action.run]));
+    cmd->angleturn = static_cast<int16_t>(std::lround(action.turn * 65536.0 / 360.0));
+    cmd->buttons = (action.fire ? BT_ATTACK : 0) | (action.use ? BT_USE : 0);
+    if(action.weapon) {
+        weaponinfo_t *weapon = P_GetPlayerWeapon(&player, action.weapon - 1);
+        if(weapon && E_PlayerOwnsWeapon(&player, weapon)) {
+            if(demo_version >= 401) {
+                const auto *slot = E_FindEntryForWeaponInSlotIndex(&player, weapon, action.weapon - 1);
+                cmd->weaponID = weapon->id + 1;
+                if(slot) cmd->slotIndex = slot->slotindex;
+            } else {
+                cmd->buttons |= BT_CHANGE | (weapon->dehnum << BT_WEAPONSHIFT);
+            }
+        }
+    }
+    return true;
+}
+
+void DD_Export(SDL_Surface *surface)
+{
+    if(!enabled || !surface || surface->w <= 0 || surface->h <= 0 ||
+       surface->w > DD_MAX_WIDTH || surface->h > DD_MAX_HEIGHT) return;
+    observeLifecycle();
+    auto *pixels = reinterpret_cast<unsigned char *>(header) + DD_HEADER_SIZE;
+    const int stride = surface->w * 4;
+    const size_t bytes = static_cast<size_t>(stride) * surface->h;
+    convertedPixels.resize(bytes);
+    if(SDL_ConvertPixels(surface->w, surface->h, surface->format->format,
+                         surface->pixels, surface->pitch, SDL_PIXELFORMAT_ARGB8888,
+                         convertedPixels.data(), stride) != 0) return;
+    // Compare exact exported pixels before opening the seqlock. The private
+    // conversion buffer is bounded by DD_MAX_WIDTH/HEIGHT, reused each frame.
+    // Header telemetry still advances even when a frozen view needs no upload.
+    const bool changed = !frames || header->width != static_cast<unsigned>(surface->w) ||
+                         header->height != static_cast<unsigned>(surface->h) ||
+                         std::memcmp(pixels, convertedPixels.data(), bytes) != 0;
+    beginWrite();
+    if(changed) {
+        std::memcpy(pixels, convertedPixels.data(), bytes);
+        ++frames;
+    }
+    header->width = surface->w;
+    header->height = surface->h;
+    header->stride = stride;
+    header->bot = autoplay;
+    header->paused = suspended;
+    header->audible = audioGate.load(std::memory_order_acquire);
+    header->gamestate = gamestate;
+    header->frame = frames;
+    header->tic = gametic;
+    header->leveltime = leveltime;
+    const player_t &player = players[consoleplayer];
+    header->health = player.health;
+    header->x = player.mo ? player.mo->x : 0;
+    header->y = player.mo ? player.mo->y : 0;
+    header->kills = player.killcount;
+    header->items = player.itemcount;
+    header->secrets = player.secretcount;
+    snprintf(header->map, sizeof(header->map), "%s", gamemapname);
+    header->campaign = campaigns;
+    header->audio_peak = audioPeak.load(std::memory_order_relaxed);
+    header->angle = player.mo ? static_cast<int32_t>(player.mo->angle) : 0;
+    const bool legacyPixels = (surface->w == 320 && surface->h == 200) ||
+                              (surface->w == 640 && surface->h == 400);
+    header->pixel_aspect_num = legacyPixels ? 5 : 1;
+    header->pixel_aspect_den = legacyPixels ? 6 : 1;
+    header->fov = fov;
+    header->view_width = viewwindow.width;
+    header->view_height = viewwindow.height;
+    header->hud_layout = hud_enabled ? hud_overlaylayout : 0;
+    header->bot_replans = replans;
+    header->render_fps = DD_RenderFPS();
+    header->render_lerp = gamestate == GS_LEVEL ? view.lerp : FRACUNIT;
+    header->render_angle = static_cast<int32_t>(viewangle);
+    header->human_quits = humanQuits;
+    header->owner = owner;
+    header->agent_gen = agentGeneration;
+    header->armor = player.armorpoints;
+    static const char *ammoNames[] = {"AmmoClip", "AmmoShell", "AmmoCell", "AmmoMissile"};
+    for(unsigned i = 0; i < 4; ++i) header->ammo[i] = E_GetItemOwnedAmountName(&player, ammoNames[i]);
+    header->ready_weapon = player.readyweapon ? player.readyweapon->dehnum : -1;
+    header->weapons_owned = 0;
+    for(unsigned i = 0; i < NUMWEAPONS; ++i) {
+        const auto *weapon = E_WeaponForDEHNum(i);
+        if(weapon && E_PlayerOwnsWeapon(&player, weapon)) header->weapons_owned |= 1U << i;
+    }
+    header->keys = 0;
+    static const char *keyNames[] = {ARTI_BLUECARD, ARTI_YELLOWCARD, ARTI_REDCARD,
+                                   ARTI_BLUESKULL, ARTI_YELLOWSKULL, ARTI_REDSKULL};
+    for(unsigned i = 0; i < 6; ++i)
+        if(E_GetItemOwnedAmountName(&player, keyNames[i])) header->keys |= 1U << i;
+    header->z = player.mo ? player.mo->z : 0;
+    header->momx = player.mo ? player.mo->momx : 0;
+    header->momy = player.mo ? player.mo->momy : 0;
+    header->damage_count = player.damagecount;
+    header->deaths = deaths;
+    header->levels_completed = levelsCompleted;
+    header->bot_stuck = stuckEvents;
+    publishedRevision = revision;
+    endWrite();
+}
+
+void DD_Heartbeat()
+{
+    if(!enabled || !header || !header->frame) return;
+    // With no game tics or commands, the last native image remains exact. The
+    // paused heartbeat updates status without re-rendering/copying 4K pixels or
+    // making viewers upload an unchanged image again.
+    beginWrite();
+    header->audio_peak = audioPeak.load(std::memory_order_relaxed);
+    endWrite();
+}
+
+void DD_PostMix(unsigned char *samples, int bytes, unsigned short format)
+{
+    if(!desktopRequested || bytes <= 0) return;
+    // This tail hook follows the existing engine mixer, including music,
+    // digital SFX, reverb and equalization. Never replace its postmix callback.
+    // Gating the final samples also prevents an old SFX/reverb tail or startup
+    // music buffer from leaking sound during the first muted desktop frame.
+    if(!audioGate.load(std::memory_order_acquire)) {
+        memset(samples, SDL_AUDIO_ISFLOAT(format) || SDL_AUDIO_ISSIGNED(format) ? 0 : 0x80, bytes);
+        audioPeak.store(0, std::memory_order_relaxed);
+        return;
+    }
+    double peak = 0;
+    if(SDL_AUDIO_ISFLOAT(format) && SDL_AUDIO_BITSIZE(format) == 32) {
+        const float *data = reinterpret_cast<const float *>(samples);
+        for(int i = 0; i < bytes / 4; ++i)
+            peak = std::max(peak, std::abs(static_cast<double>(data[i])) * 32767.0);
+    } else if(SDL_AUDIO_BITSIZE(format) == 16) {
+        const int16_t *data = reinterpret_cast<const int16_t *>(samples);
+        for(int i = 0; i < bytes / 2; ++i)
+            peak = std::max(peak, std::abs(static_cast<double>(data[i])));
+    }
+    audioPeak.store(static_cast<uint32_t>(std::min(peak, 32767.0)), std::memory_order_relaxed);
+}
+
+void DD_FinaleBegin()
+{
+    finaleHoldTics = humanFinaleTics = 0;
+    finaleButtons = false;
+    agentLifecycleTics = 0;
+    agentLifecycleState = GS_FINALE;
+    clearAgentAction();
+}
+
+void DD_FinaleTic(bool eligible, bool cast)
+{
+    // Story text keeps its native read/acceleration timing; the bunny scroller
+    // must reach END6 before eligible is true. Count the same finale under both
+    // owners so handing it back never restarts a hold the human already saw.
+    if(!enabled || suspended) return;
+    if(!autoplay) ++humanFinaleTics;
+    const bool buttons = players[consoleplayer].cmd.buttons & (BT_ATTACK | BT_USE);
+    const bool pressed = buttons && !finaleButtons;
+    finaleButtons = buttons;
+    if(!eligible) return;
+    ++finaleHoldTics;
+    const unsigned hold = (cast ? 12 : 5) * 35;
+    const bool automatic = autoplay && (finaleHoldTics >= hold || humanFinaleTics >= hold);
+    // Static episode art can be dismissed by native fire/use. Preserve the
+    // cast's original keyboard behavior and never skip the bunny animation.
+    const bool skip = !autoplay && !cast && pressed && finaleHoldTics > 1;
+    if(!automatic && !skip) return;
+    if(!campaignStart.empty()) {
+        ++campaigns;
+        G_DeferedInitNew(gameskill, campaignStart.c_str());
+        return;
+    }
+    int episode = GameModeInfo->flags & GIF_MAPXY ? 1 : gameepisode + 1;
+    if(episode > GameModeInfo->numEpisodes || GameModeInfo->flags & GIF_MAPXY) {
+        episode = 1;
+        ++campaigns;
+    }
+    G_DeferedInitNewNum(gameskill, episode, 1);
+}
