+bool parseKey(const std::string &line, int &key, int &down, int &character, int &repeat)
+{
+    std::istringstream fields(line);
+    std::string name;
+    character = repeat = 0;
+    if(!(fields >> name >> key >> down) || name != "key") return false;
+    if(!(fields >> std::ws).eof()) {
+        if(!(fields >> character)) return false;
+        if(!(fields >> std::ws).eof() && !(fields >> repeat)) return false;
+    }
+    return (fields >> std::ws).eof() && key > 0 && key < NUMKEYS &&
+           (down == 0 || down == 1) && (character == 0 || (character >= 32 && character <= 126)) &&
+           (repeat == 0 || repeat == 1) && (down || (!character && !repeat));
+}
