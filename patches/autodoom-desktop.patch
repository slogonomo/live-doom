+void watchBotProgress()
+{
+    const player_t &player = players[consoleplayer];
+    const Mobj *actor = player.mo;
+    if(gamestate != GS_LEVEL || !actor || player.health <= 0 || !botMap) {
+        progress.valid = false;
+        return;
+    }
+    // Only AutoDoom owns this navigation recovery. Human/agent play and pauses
+    // preserve history but neither consume nor reset its running-world deadline.
+    if(owner != 0 || suspended || paused) {
+        // Notice a same-map restart during human/agent play even if its clock
+        // has passed the old value again by the time AutoDoom regains control.
+        if(progress.valid && (progress.actor != actor || progress.map != gamemapname ||
+                              leveltime < progress.time)) progress.valid = false;
+        if(progress.valid) progress.time = leveltime;
+        return;
+    }
+    const bool fresh = !progress.valid || progress.actor != actor || progress.map != gamemapname ||
+                       leveltime < progress.time;
+    if(!fresh && leveltime == progress.time) return;
+    uint32_t weapons = 0, keys = 0;
+    for(unsigned i = 0; i < NUMWEAPONS; ++i) {
+        const auto *weapon = E_WeaponForDEHNum(i);
+        if(weapon && E_PlayerOwnsWeapon(&player, weapon)) weapons |= 1U << i;
+    }
+    static const char *keyNames[] = {ARTI_BLUECARD, ARTI_YELLOWCARD, ARTI_REDCARD,
+                                   ARTI_BLUESKULL, ARTI_YELLOWSKULL, ARTI_REDSKULL};
+    for(unsigned i = 0; i < 6; ++i)
+        if(E_GetItemOwnedAmountName(&player, keyNames[i])) keys |= 1U << i;
+    if(fresh) {
+        progress.visited.reset();
+        progress.weapons = progress.keys = 0;
+    }
+    const unsigned cell = progressCell(actor->y) * 512 + progressCell(actor->x);
+    const bool explored = !progress.visited.test(cell);
+    const bool collected = player.killcount > progress.kills || player.itemcount > progress.items ||
+                           player.secretcount > progress.secrets ||
+                           (weapons & ~progress.weapons) || (keys & ~progress.keys);
+    progress.visited.set(cell);
+    if(fresh || explored || collected) progress.tics = 0;
+    else if(++progress.tics >= 25 * 35) {
+        // Reconsider navigation only. Keep visited history so pacing through
+        // familiar space cannot indefinitely postpone another recovery hint.
+        // mapInit preserves health, inventory, actor and the live map.
+        bots[consoleplayer].mapInit();
+        ++replans;
+        ++stuckEvents;
+        progress.tics = 0;
+    }
+    progress.valid = true;
+    progress.actor = actor;
+    progress.map = gamemapname;
+    progress.time = leveltime;
+    progress.kills = player.killcount;
+    progress.items = player.itemcount;
+    progress.secrets = player.secretcount;
+    progress.weapons |= weapons;
+    progress.keys |= keys;
+}
