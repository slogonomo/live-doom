+const char *command(const std::string &line)
+{
+    int value, key, character, repeat, width, height;
+    double dx, dy, sensitivity;
+    char tail;
+    uint32_t nextOwner, generation;
+    AgentAction nextAction;
+    if(line.compare(0, 9, "campaign ") == 0) {
+        const std::string label = line.substr(9);
+        if(label == "none") campaignStart.clear();
+        else {
+            const bool episode = label.size() == 4 && label[0] == 'E' &&
+                label[1] >= '1' && label[1] <= '9' && label[2] == 'M' &&
+                label[3] >= '1' && label[3] <= '9';
+            const bool numbered = label.size() == 5 && label.compare(0, 3, "MAP") == 0 &&
+                label[3] >= '0' && label[3] <= '9' && label[4] >= '0' && label[4] <= '9';
+            if(!episode && !numbered) return "ERR invalid campaign start\n";
+            const int lump = wGlobalDir.checkNumForName(label.c_str());
+            if(lump < 0 || P_CheckLevel(&wGlobalDir, lump) == LEVEL_FORMAT_INVALID)
+                return "ERR campaign start map missing\n";
+            campaignStart = label;
+        }
+        return "OK\n";
+    } else if(sscanf(line.c_str(), "pause %d %c", &value, &tail) == 1 && (value == 0 || value == 1)) {
+        suspended = value;
+        if(suspended) {
+            releaseInput();
+            clearAgentAction();
+        }
+    } else if(parseOwner(line, nextOwner, generation)) {
+        setOwner(nextOwner, generation);
+    } else if(parseAction(line, generation, nextAction)) {
+        if(owner != 1) return "ERR agent control inactive\n";
+        if(generation != agentGeneration) return "ERR agent generation mismatch\n";
+        // A lease survives a pause, but no action received during suspension
+        // may become latent movement when the desktop later resumes.
+        if(suspended || nativeQuitPending || gamestate != GS_LEVEL ||
+           !players[consoleplayer].mo || players[consoleplayer].health <= 0)
+            clearAgentAction();
+        else
+            agentAction = nextAction;
+        return "OK\n";
+    } else if(sscanf(line.c_str(), "bot %d %c", &value, &tail) == 1 && (value == 0 || value == 1)) {
+        setOwner(value ? 0 : 2, 0);
+    } else if(sscanf(line.c_str(), "audio %d %c", &value, &tail) == 1 && (value == 0 || value == 1)) {
+        audible = value;
+    } else if(parseKey(line, key, value, character, repeat)) {
+        if(autoplay || suspended || nativeQuitPending) return "ERR human control inactive\n";
+        event_t event = {value ? ev_keydown : ev_keyup, key, 0, 0, !!repeat};
+        postInput(event);
+        if(character) {
+            event_t text = {ev_text, character, 0, 0, !!repeat};
+            postInput(text);
+        }
+        if(value) {
+            if(std::find(heldKeys.begin(), heldKeys.end(), key) == heldKeys.end())
+                heldKeys.push_back(key);
+        } else {
+            heldKeys.erase(std::remove(heldKeys.begin(), heldKeys.end(), key), heldKeys.end());
+        }
+    } else if(sscanf(line.c_str(), "text %d %c", &character, &tail) == 1 &&
+              character >= 32 && character <= 126) {
+        if(autoplay || suspended || nativeQuitPending) return "ERR human control inactive\n";
+        event_t event = {ev_text, character, 0, 0, false};
+        postInput(event);
+    } else if(sscanf(line.c_str(), "mouse %lf %lf %c", &dx, &dy, &tail) == 2 &&
+              std::isfinite(dx) && std::isfinite(dy) && std::abs(dx) <= 16384 && std::abs(dy) <= 16384) {
+        if(autoplay || suspended || nativeQuitPending) return "ERR human control inactive\n";
+        event_t event = {ev_mouse, 0, dx, -dy, false};
+        postInput(event);
+    } else if(sscanf(line.c_str(), "controls %lf %d %c", &sensitivity, &value, &tail) == 2 &&
+              std::isfinite(sensitivity) && sensitivity >= 0.1 && sensitivity <= 4.0 &&
+              (value == 0 || value == 1)) {
+        controlSensitivity = sensitivity;
+        controlMouselook = value;
+        applyControls();
+    } else if(sscanf(line.c_str(), "render %d %c", &value, &tail) == 1 && value >= 35 && value <= 120) {
+        humanRenderFPS = value;
+    } else if(line == "release") {
+        releaseInput();
+        clearAgentAction();
+    } else if(line == "save") {
+        if(!liveCheckpointWorld())
+            return "ERR no live level to save\n";
+        return save() ? "OK\n" : "ERR checkpoint write failed\n";
+    } else if(line == "load") {
+        const auto path = savePath();
+        if(access(path.c_str(), R_OK) != 0) return "ERR checkpoint missing\n";
+        releaseInput();
+        clearAgentAction();
+        G_LoadGame(path.c_str(), 7, true);
