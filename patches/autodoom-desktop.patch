+// Write a native checkpoint without sending a simulation tic. Rename only a
+// successfully closed file so stopping a paused desktop cannot lose its save.
+bool G_SaveGameImmediate(int slot, const char *description)
+{
+   if(gamestate != GS_LEVEL || !players[consoleplayer].mo ||
+      !usergame || demoplayback || advancedemo || gameaction == ga_playdemo)
+      return false;
+   char name[4096], temporary[4128], text[24] = {};
+   G_SaveGameName(name, sizeof(name), slot);
+   psnprintf(temporary, sizeof(temporary), "%s.tmp", name);
+   psnprintf(text, sizeof(text), "%s", description);
+   const bool previousHubChange = hub_changelevel;
+   hub_changelevel = true; // suppress the periodic checkpoint HUD message
+   const bool written = P_SaveCurrentLevel(temporary, text, true);
+   hub_changelevel = previousHubChange;
+   if(!written) return false;
+   FILE *file = fopen(temporary, "rb");
+   if(!file) return false;
+   fseek(file, 0, SEEK_END);
+   const long size = ftell(file);
+   fclose(file);
+   if(size < 128) return false;
+   return rename(temporary, name) == 0;
+}
