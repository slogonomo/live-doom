+// Check every buffered and OS write before a desktop checkpoint can replace
+// its previous file. The existing void close() intentionally hides errors.
+bool OutBuffer::closeChecked(bool durable)
+{
+   bool success = true;
+   try { if(f) success = flush(); }
+   catch(...) { success = false; }
+   if(f)
+   {
+      if(fflush(f) != 0) success = false;
+      if(durable && success)
+      {
+#ifdef _WIN32
+         if(_commit(_fileno(f)) != 0) success = false;
+#else
+         if(fsync(fileno(f)) != 0) success = false;
+#endif
+      }
+      if(fclose(f) != 0) success = false;
+      f = nullptr;
+   }
+   BufferedFileBase::close();
+   return success;
+}
+
