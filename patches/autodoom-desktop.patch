+bool parseOwner(const std::string &line, uint32_t &next, uint32_t &generation)
+{
+    std::istringstream fields(line);
+    std::string name;
+    long long parsedOwner, parsedGeneration;
+    if(!(fields >> name >> parsedOwner >> parsedGeneration) || name != "owner" ||
+       !(fields >> std::ws).eof() || parsedOwner < 0 || parsedOwner > 2 ||
+       parsedGeneration < 0 || static_cast<unsigned long long>(parsedGeneration) > UINT32_MAX)
+        return false;
+    next = static_cast<uint32_t>(parsedOwner);
+    generation = static_cast<uint32_t>(parsedGeneration);
+    return true;
+}
+
+bool parseAction(const std::string &line, uint32_t &generation, AgentAction &action)
+{
+    std::istringstream fields(line);
+    std::string name;
+    long long parsedGeneration;
+    int hold = 500;
+    if(!(fields >> name >> parsedGeneration >> action.move >> action.strafe >> action.turn >>
+         action.fire >> action.use >> action.run >> action.weapon) || name != "action") return false;
+    if(!(fields >> std::ws).eof() && !(fields >> hold)) return false;
+    if(!(fields >> std::ws).eof() || parsedGeneration < 0 ||
+       static_cast<unsigned long long>(parsedGeneration) > UINT32_MAX ||
+       !std::isfinite(action.move) || !std::isfinite(action.strafe) || !std::isfinite(action.turn) ||
+       std::abs(action.move) > 1 || std::abs(action.strafe) > 1 || std::abs(action.turn) > 45 ||
+       (action.fire != 0 && action.fire != 1) || (action.use != 0 && action.use != 1) ||
+       (action.run != 0 && action.run != 1) || action.weapon < 0 || action.weapon > 9 ||
+       hold < 1 || hold > 1000) return false;
+    generation = static_cast<uint32_t>(parsedGeneration);
+    action.remaining = (hold * 35 + 999) / 1000;
+    return true;
+}
