+    std::memset(g_input.mousebuttons, 0, sizeof(g_input.mousebuttons));
+    std::memset(g_input.joyaxes, 0, sizeof(g_input.joyaxes));
+    g_input.mousex = g_input.mousey = 0;
+    g_input.sendpause = false;
