+// Retain mixer/decoder state, but release the physical stream while quiet.
+// Main-thread only: never close/reopen from the postmix callback.
+void serviceAudioDevice(uint64_t now)
+{
+    const bool wanted = audible && !suspended;
+    if(!Mix_QuerySpec(nullptr, nullptr, nullptr)) {
+        audioGate.store(false, std::memory_order_release);
+        audioPeak.store(0, std::memory_order_relaxed);
+        return;
+    }
+    bool detached = Mix_LiveDoomDeviceSuspended() != 0;
+    if(!wanted) {
+        if(!audioMutePending) {
+            audioMutePending = true;
+            audioMutedSince = now;
+        }
+        if(!detached && now - audioMutedSince >= 1500) {
+            audioGate.store(false, std::memory_order_release);
+            S_StopSounds(true);
+            if(Mix_LiveDoomSuspendDevice(1) == 0) {
+                detached = true;
+                deviceSuspended = -1;
+                fprintf(stderr, "Live Doom audio device released while inaudible\n");
+            }
+        }
+    } else {
+        audioMutePending = false;
+        if(detached && now >= audioRetryAt) {
+            // Open paused: discard transient sounds before a callback can
+            // resume, then reapply the actual game suspension below.
+            Mix_PauseAudio(1);
+            S_StopSounds(true);
+            if(Mix_LiveDoomSuspendDevice(0) == 0) {
+                detached = false;
+                deviceSuspended = -1;
+                audioRetryAt = 0;
+                audioReopenWarning = false;
+                fprintf(stderr, "Live Doom audio device resumed\n");
+            } else {
+                audioRetryAt = now + 2000;
+                if(!audioReopenWarning) {
+                    fprintf(stderr, "Live Doom audio device unavailable; retrying: %s\n", SDL_GetError());
+                    audioReopenWarning = true;
+                }
+            }
+        }
+    }
+    audioGate.store(wanted && !detached, std::memory_order_release);
+    if(!wanted || detached) audioPeak.store(0, std::memory_order_relaxed);
+    const int pauseDevice = suspended || detached;
+    if(deviceSuspended != pauseDevice) {
+        Mix_PauseAudio(pauseDevice);
+        deviceSuspended = pauseDevice;
+    }
+}
